<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Celestite.ViewModels.Dialogs"
             xmlns:network="using:Celestite.Network.Models" MinWidth="500"
             xmlns:locale="using:Celestite.I18N"
             xmlns:icons="clr-namespace:FluentAvalonia.UI.Controls.IconElement;assembly=FluentAvalonia"
             x:DataType="vm:GameCatalogDialogViewModel"
             x:Class="Celestite.Dialogs.Games.AddClientGameDialog">

	<StackPanel Spacing="8">
		<Grid ColumnDefinitions="Auto,*">
			<icons:SymbolIcon Symbol="Search" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox Grid.Column="1" Text="{Binding FilterText, Mode=TwoWay}" Watermark="{x:Static locale:Localization.CatalogSearch}" />
		</Grid>
		<TextBlock Text="{x:Static locale:Localization.CatalogSearchScope}" TextWrapping="Wrap"
                   Theme="{StaticResource CaptionTextBlockStyle}"/>
		<TextBlock Text="{Binding ResultCount}" Theme="{StaticResource CaptionTextBlockStyle}" />
		<StackPanel IsVisible="{Binding IsEmpty}" Spacing="8" MinHeight="90" HorizontalAlignment="Center">
			<icons:SymbolIcon Symbol="Games" FontSize="24" HorizontalAlignment="Center"/>
			<TextBlock Text="{x:Static locale:Localization.CatalogEmpty}"/>
		</StackPanel>
		<ListBox IsVisible="{Binding !IsEmpty}" ItemsSource="{Binding VisibleGames}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" Height="320">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="network:SearchGameData">
					<StackPanel Orientation="Horizontal" Spacing="10" Margin="4">
						<Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
							<Image Source="{Binding Image^}" Width="48" Height="48" Stretch="UniformToFill"/>
						</Border>
						<StackPanel VerticalAlignment="Center" Spacing="2">
							<TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxWidth="385" />
							<TextBlock Text="{Binding ProductId}" Theme="{StaticResource CaptionTextBlockStyle}" />
						</StackPanel>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</StackPanel>
</UserControl>
