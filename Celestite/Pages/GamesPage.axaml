<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Celestite.ViewModels.Pages"
             xmlns:nav="using:Celestite.ViewModels.Navigation"
             xmlns:locale="using:Celestite.I18N"
             xmlns:fluent="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:icons="clr-namespace:FluentAvalonia.UI.Controls.IconElement;assembly=FluentAvalonia"
             xmlns:ctrls="using:Celestite.Controls"
             xmlns:network="using:Celestite.Network.Models"
             x:DataType="vm:GamesPageViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Celestite.Pages.GamesPage">

	<UserControl.DataContext>
		<vm:GamesPageViewModel></vm:GamesPageViewModel>
	</UserControl.DataContext>
	<fluent:Frame CacheSize="1"
				  NavigationPageFactory="{x:Static nav:GameNavigationFactory.Instance}"
				  IsNavigationStackEnabled="True">
		<Grid Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}, Path=Bounds.Height}"
			  RowDefinitions="20, auto, 8, auto, 8, *">
			<DockPanel LastChildFill="True" Grid.Row="1" Margin="0,0,0,4">
				<fluent:CommandBar DockPanel.Dock="Right" DefaultLabelPosition="Right" VerticalAlignment="Center">
					<fluent:CommandBar.PrimaryCommands>
						<fluent:CommandBarButton IconSource="Add" Label="{x:Static locale:Localization.OpenGameCatalog}" Command="{Binding OpenGameCatalogCommand}"/>
						<fluent:CommandBarButton IconSource="ArrowClockwise" Label="{x:Static locale:Localization.CatalogRefresh}" Command="{Binding RemoteUpdateCommand}" IsEnabled="{Binding !IsLibraryLoading}"/>
						<fluent:CommandBarToggleButton IconSource="EyeOff" Label="{x:Static locale:Localization.ToggleShowHiddenGames}" IsChecked="{Binding !IsOnlyShowViewable, Mode=TwoWay}"/>
					</fluent:CommandBar.PrimaryCommands>
				</fluent:CommandBar>
				<TabControl SelectedIndex="{Binding SelectedIndex}" VerticalAlignment="Center">
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="7">
								<icons:SymbolIcon Symbol="Games" VerticalAlignment="Center"/>
								<TextBlock Text="{x:Static locale:Localization.TabClientGames}" VerticalAlignment="Center"/>
							</StackPanel>
						</TabItem.Header>
					</TabItem>
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="7">
								<icons:SymbolIcon Symbol="Globe" VerticalAlignment="Center"/>
								<TextBlock Text="{x:Static locale:Localization.TabBrowserGames}" VerticalAlignment="Center"/>
							</StackPanel>
						</TabItem.Header>
					</TabItem>
				</TabControl>
			</DockPanel>
			<Grid Grid.Row="3" ColumnDefinitions="Auto,*">
			<icons:SymbolIcon Symbol="Search" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<AutoCompleteBox Grid.Column="1"
				Watermark="{x:Static locale:Localization.TextBoxSearchGames}"
				Text="{Binding FilterText}"
				ItemsSource="{Binding GamesSource}"
				ValueMemberBinding="{Binding Title, DataType=network:MyGame}"
				MinimumPrefixLength="1"
				ItemFilter="{x:Static vm:GamesPageViewModel.AutoCompleteFilter}"
                >
				<AutoCompleteBox.ItemTemplate>
					<DataTemplate x:DataType="network:MyGame">
						<StackPanel HorizontalAlignment="Left"
									VerticalAlignment="Center" Margin="0 4">
							<TextBlock Text="{Binding Romaji}" FontSize="8" />
							<TextBlock Text="{Binding TitleRuby}" FontSize="8" />
							<TextBlock Text="{Binding Title}"
									   Theme="{StaticResource CaptionTextBlockStyle}"
									   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
						</StackPanel>
					</DataTemplate>
				</AutoCompleteBox.ItemTemplate>
			</AutoCompleteBox>
			</Grid>
			<ProgressBar Grid.Row="4" Height="3" IsIndeterminate="True" IsVisible="{Binding IsLibraryLoading}"/>
			<StackPanel Grid.Row="5" IsVisible="{Binding ShowLibraryStatus}" Spacing="10"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
				<icons:SymbolIcon Symbol="Games" FontSize="28" HorizontalAlignment="Center"/>
				<TextBlock Text="{Binding LibraryStatus}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
			</StackPanel>
			<ScrollViewer Grid.Row="5" ScrollViewer.VerticalScrollBarVisibility="Hidden">
				<ItemsRepeater ItemsSource="{Binding Games}">
					<ItemsRepeater.Layout>
						<StackLayout Spacing="8"></StackLayout>
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate x:DataType="network:MyGame">
							<ctrls:DmmGameExpander
								Header="{Binding Title}"
								Description="{Binding Romaji}"
								Description2="{Binding TitleRuby}"
								GameIcon="{Binding Image^}"
								Action1="Bot"
								Action2="Settings"
								Action3="Play"
								Action1Label="{x:Static locale:Localization.ButtonEmuLaunch}"
								Action2Label="{x:Static locale:Localization.ButtonSettings}"
									Action3Label="{Binding LaunchButtonText}"
								Action1Command="{Binding EmulateLaunchCommand}"
								Action2Command="{Binding OpenGameSettingsCommand}"
								Action3Command="{Binding LaunchGameCommand}"
                            >
								<Classes.safety>
									<MultiBinding Converter="{x:Static BoolConverters.And}">
										<Binding Path="$parent[UserControl].((vm:GamesPageViewModel)DataContext).SafeIconEnabled"></Binding>
										<Binding Path="ApiType.IsAdult"></Binding>
									</MultiBinding>
								</Classes.safety>
							</ctrls:DmmGameExpander>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>
		</Grid>
	</fluent:Frame>

</UserControl>
